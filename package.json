{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tsc": "tsc",
    "build": "tsc && vite build --mode production",
    "lint": "biome check",
    "lint-server": "cargo fmt --check",
    "fix": "biome check --write",
    "preview": "vite preview",
    "db": "spacetime start",
    "generate": "spacetime ${SPACETIME_ROOT:+--root-dir=$SPACETIME_ROOT} generate --lang typescript --out-dir src/module_bindings --module-path .",
    "publish": "spacetime publish --server local --module-path . space",
    "publish-prod": "spacetime build --module-path . && rsync target/wasm32-unknown-unknown/release/space.wasm -e 'ssh -p 32022' ubuntu@o1.gempir.com:/home/ubuntu/ && ssh -p32022 ubuntu@o1.gempir.com /stdb/bin/current/spacetimedb-cli publish -y -s local-prod --bin-path /home/ubuntu/space.wasm space"
  },
  "dependencies": {
    "@babylonjs/core": "^9.6.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "spacetimedb": "^2.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.11"
  }
}
