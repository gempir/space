{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tsc": "tsc",
    "build": "tsc && vite build",
    "lint": "biome check",
    "lint-server": "cargo fmt",
    "fix": "biome check --write",
    "preview": "vite preview",
    "db": "spacetime start",
