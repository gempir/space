{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tsc": "tsc",
    "build": "tsc && vite build --mode production",
    "lint": "biome check",
    "lint-server": "cargo fmt",
    "fix": "biome check --write",
    "preview": "vite preview",
    "db": "spacetime start",
    "generate": "spacetime generate --lang typescript --out-dir src/module_bindings --project-path .",
    "publish": "spacetime publish --server local --project-path . space",
    "publish-prod": "spacetime build && rsync target/wasm32-unknown-unknown/release/space.wasm -e 'ssh -p 32022' ubuntu@o1.gempir.com:/home/ubuntu/ && ssh -p32022 ubuntu@o1.gempir.com /stdb/bin/current/spacetimedb-cli publish -y -s local-prod --bin-path /home/ubuntu/space.wasm space"
  },
  "dependencies": {
    "@pixi/react": "^8.0.5",
    "pixi.js": "^8.2.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "spacetimedb": "^1.11.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "typescript": "~5.9.3",
    "vite": "npm:rolldown-vite@7.3.0"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
