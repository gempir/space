    "publish": "spacetime publish --server local --project-path . space"
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "spacetimedb": "^1.11.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "typescript": "~5.9.3",
    "vite": "npm:rolldown-vite@7.3.0"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
